  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Dialogue
  textComponent: {fileID: 444311270}
  lines:
  - Hello there my little slave
  - Well how are you liking your new home
  - Great isn't it
  - Well now then let me cut to the chase
  - To get out of here alive you will be playing a little game for my entertainment
  - if you win then you are free and if you fail, you will be my slave
  - Forever...
  - 'Well then good luck! '
  - The first stage awaits...
  textSpeed: 0.021
