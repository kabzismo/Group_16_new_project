  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1986f3f092c477c48b126444d00447f5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Dialogue
  textComponent: {fileID: 1959315140}
  lines:
  - Hello my little slave...
  - Well how are you liking your new home?
  - Great isn't it?
  - Well then, let me cut to the chase
  - To get out of here alive you will be playing a little game for my entertainment
  - If you win then you are free
  - If you fail, then you will be my slave
  - Forever...
  - Well then good luck!
  - The first stage awaits
  textSpeed: 0.03
  characterImage: {fileID: 1044552882}
  dialoguePanel: {fileID: 1078933861}
  levelChoicePanel: {fileID: 2036331261}
  fpController: {fileID: 0}
  interactor: {fileID: 0}
