  textComponent: {fileID: 1018367252}
  lines:
  - 'The Conductor : Hello there my little slave'
  - 'The Conductor : Well how are you liking your new home'
  - 'The Conductor : Great isn''t it'
  - 'The Conductor : Well now then let me cut to the chase'
  - 'The Conductor : To get out of here alive you will be playing a little game for
    my entertainment'
  - 'The Conductor : if you win then you are free and if you fail, you will be my
    slave'
  - 'The Conductor : Forever...'
  - 'The Conductor : Well then good luck! '
  - 'The Conductor : The first stage awaits...'
  textSpeed: 0.051
  characterImage: {fileID: 639774897}
  levelChoicePanel: {fileID: 308289819}
